# i3 — Ghostty, Thorium, Herdr, Nautilus

set $mod Mod4
set $scripts $HOME/Projects/dotfiles/scripts

set $term ghostty
set $browser thorium
set $browser_private thorium --incognito
set $files nautilus
set $editor nvim
set $ai $scripts/pi.sh

# --- startup ---
# Lock após 10 min (xautolock) — ver scripts/start-idle-lock.sh
exec --no-startup-id $scripts/start-ssh-agent.sh
exec_always --no-startup-id $scripts/start-idle-lock.sh
exec --no-startup-id nm-applet
exec_always --no-startup-id $scripts/set-165hz.sh
exec --no-startup-id xset r rate 150 50
exec_always --no-startup-id $scripts/start-picom.sh
exec --no-startup-id copyq --start-server
exec --no-startup-id $scripts/apply-theme.sh
exec --no-startup-id dunst
exec --no-startup-id disk-startup-notify

floating_modifier $mod

# Foco segue o mouse (Omarchy: follow_mouse = 1)
focus_follows_mouse yes
focus_on_window_activation focus
focus_wrapping no
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart

# --- audio (volume keys) ---
set $refresh_i3status killall -SIGUSR1 i3status
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10% && $refresh_i3status
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10% && $refresh_i3status
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status
bindsym XF86MonBrightnessUp+Shift exec --no-startup-id brightnessctl set 100%
bindsym XF86MonBrightnessDown+Shift exec --no-startup-id brightnessctl set 1%
bindsym XF86MonBrightnessUp+Mod1 exec --no-startup-id brightnessctl set 1%+
bindsym XF86MonBrightnessDown+Mod1 exec --no-startup-id brightnessctl set 1%-

# --- flameshot / capture ---
bindsym Print exec --no-startup-id flameshot gui
bindsym Mod1+Print exec --no-startup-id flameshot gui
bindsym $mod+Print exec --no-startup-id flameshot gui
bindsym $mod+Control+c exec --no-startup-id $scripts/capture.sh

# --- launcher & menus ---
bindsym $mod+space exec --no-startup-id rofi -show drun
bindsym $mod+Alt+space exec --no-startup-id $scripts/system-menu.sh
bindsym $mod+Escape exec --no-startup-id $scripts/system-menu.sh
bindsym $mod+k exec --no-startup-id $scripts/hotkeys.sh
bindsym $mod+Control+Shift+space exec --no-startup-id $scripts/theme-menu.sh
bindsym $mod+Control+n exec --no-startup-id $scripts/nixos-menu.sh
bindsym $mod+Control+space exec --no-startup-id $scripts/background-menu.sh
bindsym $mod+Control+l exec --no-startup-id $scripts/i3lock-ash.sh

# --- clipboard ---
bindsym $mod+c exec --no-startup-id $scripts/clip-copy.sh
bindsym $mod+x exec --no-startup-id $scripts/clip-cut.sh
bindsym $mod+v exec --no-startup-id $scripts/clip-paste.sh
bindsym $mod+Control+v exec --no-startup-id $scripts/clip-menu.sh

# --- launch apps ---
bindsym $mod+Return exec --no-startup-id $term
bindsym $mod+Alt+Return exec --no-startup-id $term -e herdr
bindsym $mod+grave exec --no-startup-id $term -e herdr
bindsym $mod+Shift+Return exec --no-startup-id $browser
bindsym $mod+Shift+Alt+b exec --no-startup-id $browser_private
bindsym $mod+Shift+f exec --no-startup-id $files
bindsym $mod+Shift+Alt+f exec --no-startup-id $scripts/files-cwd.sh
bindsym $mod+Shift+n exec --no-startup-id $editor
bindsym $mod+Shift+a exec --no-startup-id $term -e $ai
bindsym $mod+Shift+slash exec --no-startup-id keepassxc
bindsym $mod+Shift+o exec --no-startup-id obsidian
bindsym $mod+Shift+g exec --no-startup-id discord
bindsym F1 exec --no-startup-id $HOME/.config/emacs/bin/doom run

# --- navigating ---
bindsym $mod+q exec --no-startup-id $scripts/window-under-cursor.sh kill
bindsym $mod+w exec --no-startup-id $scripts/window-under-cursor.sh kill
bindsym Control+Mod1+Delete exec --no-startup-id $scripts/kill-all-windows.sh
bindsym $mod+t floating toggle
bindsym $mod+j layout toggle split
bindsym $mod+o exec --no-startup-id $scripts/window-pop.sh
bindsym $mod+i exec --no-startup-id $scripts/window-opacity-toggle.sh
bindsym $mod+Shift+i exec --no-startup-id $scripts/window-opacity-toggle.sh
bindsym $mod+l exec --no-startup-id $scripts/workspace-layout-toggle.sh
bindsym $mod+f fullscreen toggle
bindsym $mod+Alt+f exec --no-startup-id $scripts/window-maximize.sh
bindsym $mod+Control+f exec --no-startup-id $scripts/window-tiled-fullscreen.sh

bindsym $mod+s scratchpad show
bindsym $mod+Alt+s move container to scratchpad

bindsym $mod+Tab workspace next
bindsym $mod+Shift+Tab workspace prev
bindsym $mod+Control+Tab workspace back_and_forth

bindsym $mod+Left workspace prev
bindsym $mod+Right workspace next
bindsym $mod+Down focus down
bindsym $mod+Up focus up

bindsym $mod+Shift+Left swap left
bindsym $mod+Shift+Right swap right
bindsym $mod+Shift+Up swap up
bindsym $mod+Shift+Down swap down

bindsym $mod+Shift+Alt+Left move workspace to output left
bindsym $mod+Shift+Alt+Right move workspace to output right
bindsym $mod+Shift+Alt+Up move workspace to output up
bindsym $mod+Shift+Alt+Down move workspace to output down

bindsym $mod+equal resize grow width 30 px
bindsym $mod+minus resize shrink width 30 px
bindsym $mod+Shift+equal resize grow height 30 px
bindsym $mod+Shift+minus resize shrink height 30 px

bindsym $mod+h split h
bindsym $mod+Shift+v split v
bindsym $mod+e layout toggle split
bindsym $mod+Shift+space floating toggle

bindsym Mod1+Tab focus next
bindsym Mod1+Shift+Tab focus prev

# --- system controls ---
bindsym $mod+Control+a exec --no-startup-id pavucontrol
bindsym $mod+Control+b exec --no-startup-id blueman-manager
bindsym $mod+Control+w exec --no-startup-id nm-connection-editor
bindsym $mod+Control+t exec --no-startup-id $term -e btop

# --- workspaces ---
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

bindsym $mod+Shift+Control+1 move container to workspace --no-auto-back-and-forth number $ws1
bindsym $mod+Shift+Control+2 move container to workspace --no-auto-back-and-forth number $ws2
bindsym $mod+Shift+Control+3 move container to workspace --no-auto-back-and-forth number $ws3
bindsym $mod+Shift+Control+4 move container to workspace --no-auto-back-and-forth number $ws4
bindsym $mod+Shift+Control+5 move container to workspace --no-auto-back-and-forth number $ws5
bindsym $mod+Shift+Control+6 move container to workspace --no-auto-back-and-forth number $ws6
bindsym $mod+Shift+Control+7 move container to workspace --no-auto-back-and-forth number $ws7
bindsym $mod+Shift+Control+8 move container to workspace --no-auto-back-and-forth number $ws8
bindsym $mod+Shift+Control+9 move container to workspace --no-auto-back-and-forth number $ws9
bindsym $mod+Shift+Control+0 move container to workspace --no-auto-back-and-forth number $ws10

# --- i3 config ---
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Exit i3?' -B 'Yes' 'i3-msg exit'"

# --- resize mode ---
mode "resize" {
        bindsym j resize shrink width 10 px or 10 ppt
        bindsym k resize grow height 10 px or 10 ppt
        bindsym l resize shrink height 10 px or 10 ppt
        bindsym semicolon resize grow width 10 px or 10 ppt
        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

# BEGIN THEME_COLORS
# ash — https://omarchytheme.com/themes/ash/
client.focused          #626262 #626262 #e0e0e0 #626262   #626262
client.focused_inactive #8a8a8a #8a8a8a #e0e0e0 #8a8a8a   #8a8a8a
client.unfocused        #121212 #121212 #8a8a8a #121212   #121212
client.urgent           #8a8a8a #9e9e9e #121212 #9e9e9e   #9e9e9e
client.placeholder      #121212 #121212 #8a8a8a #121212   #121212
client.background       #121212

font pango:monospace 8

bar {
  i3bar_command $HOME/.config/polybar/launch.sh
  status_command i3status
  colors {
    background #121212
    statusline #e0e0e0
    separator  #626262
    focused_workspace  #626262 #626262 #e0e0e0
    active_workspace   #121212 #8a8a8a #e0e0e0
    inactive_workspace #121212 #121212 #8a8a8a
    urgent_workspace   #9e9e9e #9e9e9e #121212
    binding_mode       #9e9e9e #9e9e9e #121212
  }
}
# END THEME_COLORS
