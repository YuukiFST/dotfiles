font-family = Terminess Nerd Font
font-size = 12
window-padding-x = 8
window-padding-y = 8
confirm-close-surface = false
clipboard-read = allow
clipboard-write = allow

# Picom aplica a transparência global (75%); o fundo do terminal fica opaco aqui.
background-opacity = 1.0
background-opacity-cells = true
window-theme = ghostty

# BEGIN THEME_COLORS
# saga — https://omarchytheme.com/themes/saga/
background = #05080a
foreground = #fff6ff
cursor-color = #b2fff3
selection-background = #ffc2df
selection-foreground = #05080a
palette = 0=#05080a
palette = 1=#ff9fbc
palette = 2=#baf7b5
palette = 3=#fff6c3
palette = 4=#b2fff3
palette = 5=#dfbaff
palette = 6=#ffc79b
palette = 7=#f3ceff
palette = 8=#4b4c4d
palette = 9=#ffaecb
palette = 10=#baf7b5
palette = 11=#fff6c3
