font-family = Terminess Nerd Font
font-size = 12
window-padding-x = 8
window-padding-y = 8
confirm-close-surface = false
clipboard-read = allow
clipboard-write = allow

# Picom aplica a transparência global (75%); o fundo do terminal fica opaco aqui.
background-opacity = 1.0
background-opacity-cells = true
window-theme = ghostty

# BEGIN THEME_COLORS
# ash — https://omarchytheme.com/themes/ash/
background = #121212
foreground = #e0e0e0
cursor-color = #e0e0e0
selection-background = #e0e0e0
selection-foreground = #121212
palette = 0=#121212
palette = 1=#8a8a8a
palette = 2=#767676
palette = 3=#9e9e9e
palette = 4=#626262
palette = 5=#8a8a8a
palette = 6=#767676
palette = 7=#e0e0e0
palette = 8=#8a8a8a
palette = 9=#9e9e9e
palette = 10=#767676
palette = 11=#b2b2b2
palette = 12=#626262
palette = 13=#8a8a8a
palette = 14=#9e9e9e
palette = 15=#ffffff
# END THEME_COLORS
